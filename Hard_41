class Solution {
    public int firstMissingPositive(int[] nums) {
        HashMap<Integer, Integer> mp = new HashMap<>();
        int least = 1;
        for (int i = 0; i < nums.length; i++) {
            mp.put(nums[i], i);
        }
        for (int i = 0; i < nums.length; i++) {
            if (mp.containsKey(least)) {
                least++;
            } else {
                return least;
            }
        }
        return least;
    }
}
